{
  // ─────────────────────────────────────────────────────────────────────────────
  // escalation-review 配置文件
  //
  // 优先级（低 → 高）：
  //   1) 本文件（插件目录内的默认值）
  //   2) ~/.dsh/escalation-review.config.json      ← 建议改这个，好找
  //   3) cordis.patch.yml 里该插件条目的 config    ← 宿主侧/批处理代管时用
  // 每次发生越界时重新读取，所以改完**即时生效，不需要重启 DSH**。
  // 支持 `//` 与 `/* */` 注释（字符串内的注释符不会被误伤）。
  // ─────────────────────────────────────────────────────────────────────────────

  // observe = 只评审并记录，不干预（你照旧被问）；enforce = 按评审结果放行/拒绝。
  // 注意：这一项现在是**调试项**，配置页默认不显示（想让它显示，就在 ~/.dsh/escalation-review.config.json 里写 "devMode": true）。
  // 随包默认 enforce；但因为总开关 enabled 默认关，装着不动时插件仍然零介入。
  // 想在接入前先观察，就把下面这行改成 "observe"。
  "enabled": false,
  "enabledText": "",
  "mode": "enforce",

  // true：第一次越界之后，用**伪造的待审动作**（假的 rm -rf、假的凭据上传…）跑一遍策略自检。
  // 同一套 reviewer、同一策略、同一段真实上下文，但**绝不执行任何工具**，只记录判定。
  // ⚠️ 自测用例**不在这个包里**：还需要把 selftestModule 指向一个提供 runSelfTest 的模块
  // （或用环境变量 DSH_ER_SELFTEST_MODULE）。没有模块时只记 selftest-unavailable，不影响评审。
  // 调用次数由那个模块里的用例数决定（不是固定值）。
  "selfTest": false,

  // 评审超时三档：**每轮** 30s / 总 100s / 间隔 5s
  // ⚠️ `attemptTimeoutMs` 是**每一轮**（一次模型调用 + 这一轮的工具调用）的上限，**不是整个 loop 的**：
  //    否则"要工具"的那一轮会把出判定的下一次调用饿死（实测第 2 次调用只剩 23s → 撞死 → fail-closed）。
  //    有了它，"本轮超时"不再等于"预算花光"，所以超时**可以重试**。
  "attemptTimeoutMs": 30000,
  // 两次尝试之间的等待（毫秒）
  "retryDelayMs": 5000,
  // 最小重试预算：扣掉等待后剩余不足这个数，就不白打一次注定失败的请求
  "minAttemptMs": 2000,
  // 整个评审的总预算（毫秒）。调用方在审批路径里等着，总等待必须有界
  "timeoutMs": 100000,

  // 同时进行的评审上限（1–4）。默认 1 = 与从前完全一致：一个接一个。
  // 调大后多个越界调用可以并行评审；达到上限时后来的**排队**（不丢弃、也不越过上限），
  // 排队等待的时间会从这次评审的总预算里扣掉，所以排队不会把一次调用拖成无限期。
  "reviewConcurrency": 1,

  // 评审时是否可用**只读工具**（自实现的受限小 loop：全在一个进程里、不建会话、不落盘）：
  //   on  = 默认：评审默认一步给判定；缺关键事实时才一次请求多个只读工具（有限多步）
  //   off = 不给工具（prompt 里不含工具协议，因此只有 1 次请求）
  // auto / always 是旧配置的别名，等价于 on。
  // 步数口径：**一步是默认路径**（证据够就直接给判定）；缺关键事实时在**一条消息里**返回一组工具
  // `{"tools":[…]}`，我们批量并行执行、一轮回灌，然后优先收尾。
  // 硬上限各自独立且写死（没有配置项）：4 步 / 3 批 / 8 次工具 / 单次 16KB / 累计 48KB / 单条路径 1024 字符；
  // **工具额度是整个评审共享的**（协议/传输重试不会重新获得读取额度），只有步数按每次请求重算；
  // 到任何一条上限就带着现有证据收尾，绝不"一个工具一步"、绝不无限游走。
  // 工具（read_file / list_dir / stat）只在宿主**只读沙箱**通道里执行（拿不到通道就拒绝执行），
  // 执行器还必须自报沙箱档位、执行后核对它回报的事实；`read_file` 只读**动作点名的那个文件**
  // （按 DSH 的 opaque 目标身份精确比对，不解析路径、不折叠大小写），目录包含判定走 backend 的
  // `fs.contains()`，shell 打开文件走 `fs.processPath()`；凭据与秘密路径（`.env*` / `*.pem` / `*.key` /
  // `*.p12` / `*.pfx` …）、二进制文件、以及拿不到 `contains`/`processPath` 能力的情况一律拒绝（fail-closed）。
  "verifyMode": "on",
  "verifyModeText": "",

  // 评审失败/超时时怎么办：deny = 直接拒绝（对齐 Codex 的 strict 档）；ask = 交回人工
  "failMode": "deny",
  // 评审判定为拒绝怎么办：deny 直接拒绝；ask 交回人工（配置页「拒绝时」）
  "denyMode": "deny",


  // 覆盖 reviewer 使用的模型；留空则跟随当前会话的 provider/model
  // 例：想省钱可以用一个更便宜快的模型专做三分类
  "provider": "",
  "model": "",

  // low 风险白名单主机：命中这些主机的常规网络操作按 low 处理；上传密钥/隐私数据仍按 high 拒绝。
  // 按自己的需要增删即可。
  "allowedHosts": [
    "registry.npmjs.org",         // npm 官方源
    "registry.npmmirror.com",     // 国内 npm 镜像
    "github.com",                 // 代码托管
    "codeload.github.com",
    "api.github.com",
    "raw.githubusercontent.com",
    "objects.githubusercontent.com",
    "gitee.com",
    "gitlab.com",
    "bitbucket.org",
    "gitcafe.com",
    "gitgud.io",
    "git.oschina.net"
  ],

  // 追加到固定策略末尾的自定义规则（自然语言，随便写）
  "policyExtra": "",

  // 只读探针的执行方式：inproc（默认，进程内、不 spawn）| shell（沙箱内只读命令）
  "probeRunner": "shell",

  // 评审思考强度（"off"/"minimal"/"low"/"medium"/"high"/"xhigh"/"max"）；留空跟随会话
  "reasoningEffort": "",

  // 白名单的文本形态（配置页用：逗号或换行分隔）。非空时**覆盖**上面的 allowedHosts
  "allowedHostsText": "",

  // 自检开关的文本形态（配置页用："true"/"false"）。非空时覆盖上面的 selfTest
  "selfTestText": "",

  // 评审日志（每次越界一行 JSON）。observe 模式下主要看这个
  "logPath": "",

  // 证据预算：只影响喂给 reviewer 的上下文大小
  "historyLimit": 12,        // 保留的「用户指令」条数
  "transcriptLimit": 40,     // transcript 事件条数
  "textLimit": 900           // 单条文本截断长度
}

